/* ===================================================================
   VxVoice - Blue Capri Theme
   Base Palette: #082032, #0C2D48, #145374, #00BFFF
   Action Accents: Call = #27AE60, Hangup = #C0392B
   =================================================================== */

* {
    color: #E8F8FF;
}

QMainWindow, QDialog, QWidget#centralWidget {
    background-color: #082032;
    color: #E8F8FF;
    font-family: "Segoe UI", "Inter", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

/* Tooltips Corporativos Nítidos e Legíveis */
QToolTip {
    background-color: #0B2940;
    color: #FFFFFF;
    border: 1px solid #00BFFF;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* Toolbars & Headers */
QFrame#headerFrame {
    background-color: #061826;
    border-bottom: 1px solid #145374;
    padding: 6px 10px;
}

/* Card de Informações Superiores do Discador */
QFrame#callInfoFrame {
    background-color: #061826;
    border: 1px solid #145374;
    border-radius: 6px;
    padding: 6px 10px;
}

QLabel {
    color: #E8F8FF;
    background: transparent;
}

QLabel#titleLabel {
    font-size: 16px;
    font-weight: bold;
    color: #00BFFF;
}

QLineEdit#callerIdDisplay {
    font-size: 18px;
    font-weight: bold;
    color: #FFFFFF;
    background-color: #04121C;
    border: 1px solid #145374;
    border-radius: 6px;
    padding: 6px 12px;
}

QLineEdit#callerIdDisplay:focus {
    border: 1px solid #00BFFF;
}

QPushButton#btnDialBackspace {
    background-color: #0D2D47;
    border: 1px solid #145374;
    border-radius: 6px;
    padding: 4px;
}

QPushButton#btnDialBackspace:hover {
    background-color: #145374;
    border: 1px solid #00BFFF;
}

QPushButton#btnDialBackspace:pressed {
    background-color: #0099CC;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #145374;
    background-color: #0C2D48;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #061826;
    color: #9EDDF9;
    padding: 8px 8px;
    font-weight: 600;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 1px;
}

QTabBar::tab:selected {
    background-color: #145374;
    color: #00BFFF;
    border-bottom: 2px solid #00BFFF;
}

QTabBar::tab:hover:!selected {
    background-color: #0B2940;
    color: #E8F8FF;
}

/* Standard Push Buttons */
QPushButton {
    background-color: #145374;
    color: #E8F8FF;
    border: 1px solid #34495E;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #34495E;
    border-color: #00BFFF;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #1F2D3D;
}

QPushButton:disabled {
    background-color: #082032;
    color: #7F8C8D;
    border-color: #0C2D48;
}

/* Exit Button (Red) */
QPushButton#exitButton {
    background-color: #C0392B;
    color: #FFFFFF;
    border: 1px solid #922B21;
    border-radius: 6px;
    padding: 4px 12px;
    font-weight: bold;
}

QPushButton#exitButton:hover {
    background-color: #E74C3C;
    border-color: #C0392B;
}

QPushButton#exitButton:pressed {
    background-color: #922B21;
}

/* Primary Action Buttons */
QPushButton#primaryButton {
    background-color: #0099CC;
    color: #FFFFFF;
    border: 1px solid #1F618D;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #00BFFF;
}

QPushButton#primaryButton:pressed {
    background-color: #1F618D;
}

/* Keypad Dial Buttons */
QPushButton.dialBtn {
    background-color: #0C2D48;
    color: #FFFFFF;
    border: 1px solid #145374;
    border-radius: 8px;
    font-size: 17px;
    font-weight: bold;
    min-height: 40px;
}

QPushButton.dialBtn:hover {
    background-color: #145374;
    border-color: #00BFFF;
}

QPushButton.dialBtn:pressed {
    background-color: #082032;
}

/* Call & Hangup Mandatory Colors */
QPushButton#callButton {
    background-color: #27AE60;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    border: 1px solid #1E8449;
    border-radius: 6px;
    min-height: 40px;
    padding: 6px 16px;
}

QPushButton#callButton:hover {
    background-color: #2ECC71;
    border-color: #27AE60;
}

QPushButton#callButton:pressed {
    background-color: #1E8449;
}

/* Botões da Barra de Ações de Contatos */
QPushButton#contactCallButton, QPushButton#contactEmailButton, QPushButton#contactEditButton, QPushButton#contactDeleteButton {
    font-size: 11px;
    font-weight: bold;
    border-radius: 5px;
    padding: 4px 6px;
}

QPushButton#contactCallButton {
    background-color: #27AE60;
    color: #FFFFFF;
    border: 1px solid #1E8449;
}

QPushButton#contactCallButton:hover {
    background-color: #2ECC71;
}

QPushButton#contactCallButton:pressed {
    background-color: #1E8449;
}

QPushButton#contactCallButton:disabled {
    background-color: #082032;
    color: #7F8C8D;
    border-color: #0C2D48;
}

QPushButton#contactEmailButton {
    background-color: #0099CC;
    color: #FFFFFF;
    border: 1px solid #1F618D;
}

QPushButton#contactEmailButton:hover {
    background-color: #00BFFF;
}

QPushButton#contactEmailButton:pressed {
    background-color: #1F618D;
}

QPushButton#contactEmailButton:disabled {
    background-color: #082032;
    color: #7F8C8D;
    border-color: #0C2D48;
}

QPushButton#contactEditButton {
    background-color: #0C2D48;
    color: #E8F8FF;
    border: 1px solid #34495E;
}

QPushButton#contactEditButton:hover {
    background-color: #145374;
    border-color: #00BFFF;
}

QPushButton#contactEditButton:disabled {
    background-color: #082032;
    color: #7F8C8D;
    border-color: #0C2D48;
}

QPushButton#contactDeleteButton {
    background-color: #7B241C;
    color: #FFFFFF;
    border: 1px solid #922B21;
}

QPushButton#contactDeleteButton:hover {
    background-color: #C0392B;
}

QPushButton#contactDeleteButton:disabled {
    background-color: #082032;
    color: #7F8C8D;
    border-color: #0C2D48;
}

QPushButton#hangupButton {
    background-color: #C0392B;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    border: 1px solid #922B21;
    border-radius: 6px;
    min-height: 40px;
    padding: 6px 16px;
}

QPushButton#hangupButton:hover {
    background-color: #E74C3C;
    border-color: #C0392B;
}

QPushButton#hangupButton:pressed {
    background-color: #922B21;
}

/* In-Call Action Control Buttons */
QPushButton.inCallBtn {
    background-color: #145374;
    color: #E8F8FF;
    border: 1px solid #34495E;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton.inCallBtn:hover {
    background-color: #34495E;
    border-color: #00BFFF;
    color: #FFFFFF;
}

QPushButton.inCallBtn:checked {
    background-color: #E67E22;
    border-color: #D35400;
    color: #FFFFFF;
}

/* Active Call Dialog Custom Styles */
QFrame#activeCallCard {
    background-color: #0C2D48;
    border: 1px solid #145374;
    border-radius: 12px;
}

QLabel#activeCallBadge {
    font-size: 12px;
    font-weight: bold;
    color: #38BDF8;
    background: transparent;
}

QLabel#activeCallName {
    font-size: 18px;
    font-weight: bold;
    color: #E8F8FF;
    background: transparent;
}

QLabel#activeCallNumber {
    font-size: 14px;
    color: #9EDDF9;
    background: transparent;
}

QLabel#activeCallCompany {
    font-size: 12px;
    color: #00BFFF;
    font-weight: 600;
    background: transparent;
}

QLabel#activeCallStatus {
    font-size: 13px;
    color: #F39C12;
    font-weight: bold;
    background: transparent;
}

QLabel#activeCallTimer {
    font-size: 24px;
    font-weight: bold;
    color: #2ECC71;
    background: transparent;
    margin-top: 4px;
}

/* Input Fields & Combos */
QLineEdit, QSpinBox, QComboBox {
    background-color: #141C24;
    color: #E8F8FF;
    border: 1px solid #145374;
    border-radius: 5px;
    padding: 6px 8px;
    selection-background-color: #00BFFF;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #00BFFF;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #145374;
}

QComboBox QAbstractItemView {
    background-color: #082032;
    color: #E8F8FF;
    selection-background-color: #00BFFF;
    border: 1px solid #145374;
}

/* Lists and Tables */
QTableView, QListView, QListWidget {
    background-color: #141C24;
    color: #E8F8FF;
    border: 1px solid #145374;
    border-radius: 5px;
    gridline-color: #0B2940;
    selection-background-color: #145374;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #082032;
    color: #E8F8FF;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #145374;
    font-weight: bold;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 6px;
    background: #145374;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #00BFFF;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #E8F8FF;
    border: 1px solid #9EDDF9;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #00BFFF;
}

/* Checkbox & Radio Buttons */
QCheckBox, QRadioButton, QGroupBox {
    color: #E8F8FF;
    spacing: 8px;
    font-size: 13px;
}

QCheckBox:disabled, QRadioButton:disabled {
    color: #7F8C8D;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #34495E;
    border-radius: 3px;
    background-color: #141C24;
}

QCheckBox::indicator:hover {
    border-color: #00BFFF;
}

QCheckBox::indicator:checked {
    background-color: #00BFFF;
    border-color: #0099CC;
}

/* Popup Notification Widget */
QFrame#notificationCard {
    background-color: #061826;
    border: 2px solid #00BFFF;
    border-radius: 10px;
}
