<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="VxVoice Enterprise Softphone"
           Language="1046"
           Codepage="1252"
           Version="3.0.0"
           Manufacturer="VxNET Comunicações e Telecomunicações"
           UpgradeCode="A5D19302-7B4F-4E89-9A52-87F95A34DC7A">

    <Package Id="*"
             Keywords="Installer,MSI,SIP,Softphone,VoIP,VxVoice"
             Description="VxVoice Enterprise Softphone v3.0.0"
             Comments="Softphone Corporativo SIP (Qt 6 + PJSIP) - VxNET Telecomunicações"
             Manufacturer="VxNET Comunicações e Telecomunicações"
             InstallerVersion="300"
             Platform="x64"
             Compressed="yes"
             InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do VxVoice já está instalada no sistema."
                  AllowSameVersionUpgrades="yes" />

    <Media Id="1" Cabinet="vxvoice.cab" EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://www.vxnet.com.br" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.vxnet.com.br" />
    <Property Id="ARPCONTACT" Value="suporte@vxnet.com.br" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Overridable="yes" Value="$(var.LicenseRtf)" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="VxVoice">

          <Component Id="C_VxVoiceExe" Guid="B7C93F1A-6D25-4890-9A1B-3C4D5E6F7A8B" Win64="yes">
            <File Id="F_VxVoiceExe" Source="$(var.ExePath)" KeyPath="yes">
              <Shortcut Id="DesktopShortcut"
                        Directory="DesktopFolder"
                        Name="VxVoice"
                        Description="VxVoice Enterprise Softphone"
                        WorkingDirectory="INSTALLFOLDER"
                        Icon="AppIcon"
                        Advertise="no" />
              <Shortcut Id="StartMenuShortcut"
                        Directory="ProgramMenuDir"
                        Name="VxVoice"
                        Description="VxVoice Enterprise Softphone"
                        WorkingDirectory="INSTALLFOLDER"
                        Icon="AppIcon"
                        Advertise="no" />
            </File>
          </Component>

          <Component Id="C_RegistryProtocols" Guid="6F7A8B9C-0D1E-2F3A-4B5C-6D7E8F9A0B1C" Win64="yes">
            <RegistryValue Root="HKCR" Key="sip" Type="string" Value="URL:SIP Protocol" />
            <RegistryValue Root="HKCR" Key="sip" Name="URL Protocol" Type="string" Value="" />
            <RegistryValue Root="HKCR" Key="sip\DefaultIcon" Type="string" Value="[INSTALLFOLDER]vxvoice.ico,0" />
            <RegistryValue Root="HKCR" Key="sip\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]VxVoice.exe&quot; &quot;%1&quot;" />

            <RegistryValue Root="HKCR" Key="tel" Type="string" Value="URL:Tel Protocol" />
            <RegistryValue Root="HKCR" Key="tel" Name="URL Protocol" Type="string" Value="" />
            <RegistryValue Root="HKCR" Key="tel\DefaultIcon" Type="string" Value="[INSTALLFOLDER]vxvoice.ico,0" />
            <RegistryValue Root="HKCR" Key="tel\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]VxVoice.exe&quot; &quot;%1&quot;" />

            <RegistryValue Root="HKLM" Key="Software\VxNET\VxVoice" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
            <RegistryValue Root="HKLM" Key="Software\VxNET\VxVoice" Name="Version" Type="string" Value="3.0.0" />
            <RegistryValue Root="HKLM" Key="Software\VxNET\VxVoice" Name="Publisher" Type="string" Value="VxNET Comunicações e Telecomunicações" />
          </Component>

        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="VxVoice">
          <Component Id="C_StartMenuDir" Guid="5E6F7A8B-9C0D-1E2F-3A4B-5C6D7E8F9A0B" Win64="yes">
            <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\VxVoice" Name="ProgramMenuInstalled" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <Feature Id="MainFeature" Title="VxVoice Enterprise Softphone" Level="1">
      <ComponentRef Id="C_VxVoiceExe" />
      <ComponentRef Id="C_StartMenuDir" />
      <ComponentRef Id="C_RegistryProtocols" />
      <ComponentGroupRef Id="AppFilesComponentGroup" />
    </Feature>

  </Product>
</Wix>
